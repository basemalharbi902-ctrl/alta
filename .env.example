APP_NAME="IIMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_TIMEZONE=Asia/Riyadh

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=iims_local
DB_USERNAME=iims
DB_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILAMENT_FILESYSTEM_DISK=public

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

BROWSERSHOT_NODE_BINARY=/usr/bin/node
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium

BCRYPT_ROUNDS=12
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15

